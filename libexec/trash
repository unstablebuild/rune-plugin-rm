#!/bin/sh
# trash lists what rm moved to trash $1, as libexec/trash-dir prints it,
# newest first, then opens a shell there to restore files from.

set -f
unset CDPATH

nl='
'

if [ -z "${1-}" ]; then
	echo 'usage: trash DIR' >&2
	exit 2
fi
if ! cd -P -- "$1" 2>/dev/null; then
	printf 'The trash is empty: %s\n' "$1"
	exec "${SHELL:-/bin/sh}"
fi

# Each directory holds what one rm moved, at its full path. rm names them,
# with no newline. ls sorts them by time.
newest=''
IFS=$nl
# shellcheck disable=SC2045
for b in $(ls -t); do
	if ! [ -d "$b" ] || [ -L "$b" ]; then
		continue
	fi
	[ -n "$newest" ] || newest=$PWD/$b
	# BSD date takes a name that is a number for seconds.
	when=$(date -r "$PWD/$b" '+%Y-%m-%d %H:%M' 2>/dev/null) || when=''
	printf '%s%s\n' "$PWD/$b" "${when:+  ($when)}"
	find "$b" ! -path "$b" \( -type d -empty -exec printf '%s/\n' {} \; -o ! -type d -print \) |
		head -n 6 | {
		n=0
		while IFS= read -r f; do
			n=$((n + 1))
			if [ "$n" -gt 5 ]; then
				echo '  …'
				break
			fi
			printf '  %s\n' "${f#"$b"}"
		done
	}
done
unset IFS

if [ -z "$newest" ]; then
	printf 'The trash is empty: %s\n' "$PWD"
	exec "${SHELL:-/bin/sh}"
fi

cat <<EOF

To restore a file, move it back to where it was, as in:

  mv $newest/path/to/file /path/to/file

EOF
exec "${SHELL:-/bin/sh}"